FROM node:24-alpine AS builder

ARG VITE_API_URL
ARG VITE_FRONT_URL

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_FRONT_URL=${VITE_FRONT_URL}

WORKDIR /app

COPY ./frontend/ .

RUN npm ci && npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /var/www/frontend

COPY ./docker/nginx/conf.d/main.conf /etc/nginx/conf.d/default.conf