FROM node:24-alpine AS builder

WORKDIR /app

COPY ./frontend/ .

RUN npm ci && npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /var/www/frontend

COPY ./docker/nginx/conf.d/main.conf /etc/nginx/conf.d/default.conf

COPY ./docker/nginx/entrypoint.sh /docker/nginx/entrypoint.sh

RUN chmod +x /docker/nginx/entrypoint.sh

ENTRYPOINT ["docker/nginx/entrypoint.sh"]