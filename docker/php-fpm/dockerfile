FROM php:8.3-fpm-alpine

RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libpq \
    && apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    postgresql-dev \
    && docker-php-ext-install pdo_pgsql \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

