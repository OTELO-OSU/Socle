FROM php:8.3-fpm-alpine

WORKDIR /var/www/backend

# Environnement de build (dev ou prod)
ARG APP_ENV=prod

RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libpq \
    freetype \
    libjpeg-turbo \
    libpng \
    libzip \
    && apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    postgresql-dev \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_pgsql gd zip \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

RUN echo "0 3 * * * cd /var/www/backend && php bin/console app:clear-token-expire" > /etc/crontabs/www-data

RUN chmod 600 /etc/crontabs/www-data

# Copier les fichiers composer
COPY --chown=www-data:www-data /backend/composer.json /backend/composer.lock ./

USER www-data

# Installer les dépendances selon l'environnement
RUN if [ "$APP_ENV" = "prod" ]; then \
        composer install --no-dev --optimize-autoloader --no-interaction --no-scripts; \
    else \
        composer install --optimize-autoloader --no-interaction --no-scripts; \
    fi

# Ensuite copier le reste du code source de l'application
COPY --chown=www-data:www-data /backend/ ./

# Exécuter les scripts Composer maintenant que le code est présent
RUN composer run-script post-install-cmd

COPY --chown=www-data:www-data docker/php-fpm/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod u+x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]
